---
// Shows an optimized photo, or a tinted placeholder when a post has no photo yet.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  height: number;
  radius?: number;
  tint?: string;
  label?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
}

const {
  src,
  alt = '',
  height,
  radius = 16,
  tint = '#1A2630',
  label = 'Photo',
  widths = [480, 800, 1200],
  sizes = '(max-width: 700px) 100vw, 400px',
  loading = 'lazy',
} = Astro.props;
---

<div class="photo" style={`height:${height}px;border-radius:${radius}px;background:${tint}`}>
  {
    src ? (
      <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} class="img" />
    ) : (
      <div class="photo-ph">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 8h3l2-3h6l2 3h3v11H4z" /><circle cx="12" cy="13" r="3.5" />
        </svg>
        <span>{label}</span>
      </div>
    )
  }
</div>

<style>
  .photo { overflow: hidden; width: 100%; }
  .photo :global(.img) { width: 100%; height: 100%; object-fit: cover; }
</style>

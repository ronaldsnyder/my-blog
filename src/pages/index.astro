---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Photo from '../components/Photo.astro';
import { TOPICS, topicFor } from '../consts';
import { getPosts, formatDate, readingTime } from '../utils';

const posts = await getPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const latest = posts.filter((p) => p !== featured).slice(0, 6);
---

<BaseLayout>
  <div class="container">
    {
      featured && (
        <section class="featured" aria-label="Featured post">
          <a class="featured-photo" href={`/posts/${featured.id}/`} tabindex="-1" aria-hidden="true">
            <Photo
              src={featured.data.cover}
              alt={featured.data.coverAlt ?? ''}
              height={520}
              radius={20}
              tint={topicFor(featured.data.topic).tint}
              label="Featured photo"
              widths={[640, 1000, 1400]}
              sizes="(max-width: 900px) 100vw, 700px"
              loading="eager"
            />
          </a>
          <div class="featured-text">
            <span class="tag">{featured.data.topic} · Featured</span>
            <h1><a href={`/posts/${featured.id}/`}>{featured.data.title}</a></h1>
            <p class="lede">{featured.data.description}</p>
            <p class="meta">{formatDate(featured.data.date)} · {readingTime(featured.body)}</p>
            <a class="button" href={`/posts/${featured.id}/`}>Read the story</a>
          </div>
        </section>
      )
    }

    {
      latest.length > 0 && (
        <section class="block" aria-labelledby="latest">
          <div class="section-head">
            <h2 id="latest">Latest posts</h2>
          </div>
          <div class="grid-cards">
            {latest.map((post) => <PostCard post={post} />)}
          </div>
        </section>
      )
    }

    <section class="block" aria-labelledby="topics">
      <div class="section-head"><h2 id="topics">Browse by topic</h2></div>
      <div class="topics">
        {
          TOPICS.map((t) => (
            <a class="topic" href={`/topics/${t.slug}/`} style={`background:${t.tint}`}>
              <span class="topic-name">{t.name}</span>
              <span class="topic-blurb">{t.blurb}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="block follow" aria-label="Follow along">
      <div>
        <h2>Follow along</h2>
        <p>New posts on cooking, trips and whatever I'm learning. No schedule, no spam.</p>
      </div>
      <a class="button light" href="/rss.xml">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M5 5a14 14 0 0 1 14 14" /><path d="M5 11a8 8 0 0 1 8 8" /><circle cx="6" cy="18" r="1.2" />
        </svg>
        Subscribe via RSS
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .featured { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; padding-top: 48px; }
  .featured-photo { flex: 999 1 560px; min-width: 0; }
  .featured-text { flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .featured h1 { font-size: clamp(36px, 5vw, 52px); line-height: 1.05; letter-spacing: -0.025em; }
  .featured h1 a { color: var(--text); }
  .featured h1 a:hover { color: var(--accent); }
  .lede { margin: 0; font-size: 18px; line-height: 1.6; color: var(--muted); }
  .featured .button { margin-top: 6px; }

  .block { margin-top: 96px; }

  .topics { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 24px; }
  .topic {
    display: flex; flex-direction: column; justify-content: flex-end;
    height: 220px; padding: 24px; border-radius: 18px; color: var(--text);
    border: 1px solid transparent; transition: border-color 0.15s;
  }
  .topic:hover { color: var(--text); border-color: var(--accent); }
  .topic-name { font-family: var(--font-display); font-size: 28px; font-weight: 700; }
  .topic-blurb { font-size: 14px; color: var(--muted); margin-top: 4px; }

  .follow {
    padding: 48px; border-radius: 24px; background: #16212b; border: 1px solid #24323f;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px;
  }
  .follow > div { flex: 1 1 420px; min-width: 0; }
  .follow h2 { font-size: 32px; margin-bottom: 8px; }
  .follow p { margin: 0; font-size: 17px; line-height: 1.55; color: #c9d1d9; }
  @media (max-width: 640px) { .follow { padding: 32px 24px; } .block { margin-top: 72px; } }
</style>

---
import { tagSlug } from '../utils';

interface Props {
  tags: string[];
  label?: string;
}

const { tags, label = 'Tags' } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags" aria-label={label}>
      {tags.map((t) => (
        <li>
          <a href={`/tags/${tagSlug(t)}/`}>#{t}</a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }
  .tags a:hover { color: var(--text); border-color: var(--accent); }
</style>
